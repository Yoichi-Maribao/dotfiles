# Sway config — aerospace/aerospace.toml と同じ操作感になるように構成する
# コマンド一覧: man 5 sway

# macOS の option(alt) に合わせて Mod1 (Alt) をメインの修飾キーにする
set $mod Mod1
# aerospace の cmd 相当 (モニタ操作用)
set $super Mod4

set $term ghostty

# vim 風の移動キー
set $left h
set $down j
set $up k
set $right l

# aerospace: default-root-container-orientation = 'auto'
# (横長モニタは横分割、縦長モニタは縦分割)
default_orientation auto

# aerospace: default-root-container-layout = 'tiles'
workspace_layout default

# aerospace はマウス追従フォーカスなし・モニタ切替時にマウスを移動する
focus_follows_mouse no
mouse_warping output

# 日本語配列 (無指定だと US 配列になり記号の位置がズレる)
input type:keyboard xkb_layout jp

# 日本語入力 (fcitx5 + mozc)。fcitx5 は sway の input-method プロトコルで動くため
# wayland ネイティブアプリは環境変数なしで変換できる。
# ターミナルから起動するアプリ向けの IM 環境変数は zsh/.zshenv で設定する。
# 注意: systemctl --user set-environment をここでやってはいけない。
# ログアウト後も残留して GNOME セッションの ibus を壊す (実際に壊れた)。
exec fcitx5 -d

# 背景 (未指定だと真っ黒でセッションが死んでいるように見える)
output * bg #1a1b26 solid_color

# ワークスペース表示と時計 (これが無いと現在のワークスペースが分からない)
bar {
    position top
    status_command sh ~/.config/sway/status.sh
    colors {
        statusline #ffffff
        background #1a1b26
        focused_workspace #7aa2f7 #7aa2f7 #1a1b26
        inactive_workspace #1a1b26 #1a1b26 #a9b1d6
    }
}

# aerospace: [gaps] inner 3 / outer left,bottom,right 3 / top 0
gaps inner 3
gaps left 3
gaps right 3
gaps bottom 3
gaps top 0

# borders 相当 (アクティブウィンドウの枠線)
default_border pixel 2
default_floating_border pixel 2

### キーバインド (aerospace [mode.main.binding] に対応) ###

# ターミナル起動 (aerospace ではコメントアウトされていたが Linux では必須)
bindsym $mod+Return exec $term

# ウィンドウを閉じる (macOS では cmd+q 相当のため aerospace には無い)
bindsym $mod+shift+q kill

# alt-slash = 'layout tiles horizontal vertical'
bindsym $mod+slash layout toggle splith splitv
# alt-comma = 'layout accordion horizontal vertical' (accordion ≒ tabbed/stacking)
bindsym $mod+comma layout toggle tabbed stacking

# alt-h/j/k/l = focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# alt-shift-h/j/k/l = move
bindsym $mod+shift+$left move left
bindsym $mod+shift+$down move down
bindsym $mod+shift+$up move up
bindsym $mod+shift+$right move right

# alt-minus / alt-shift-minus = resize smart -50/+50
bindsym $mod+minus resize shrink width 50px
bindsym $mod+shift+minus resize grow width 50px

# alt-<num> / alt-<letter> = workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+a workspace A
bindsym $mod+b workspace B
bindsym $mod+c workspace C
bindsym $mod+d workspace D
bindsym $mod+e workspace E
bindsym $mod+f workspace F
bindsym $mod+g workspace G
bindsym $mod+i workspace I
bindsym $mod+m workspace M
bindsym $mod+n workspace N
bindsym $mod+o workspace O
bindsym $mod+p workspace P
bindsym $mod+q workspace Q
bindsym $mod+r workspace R
bindsym $mod+s workspace S
bindsym $mod+t workspace T
bindsym $mod+u workspace U
bindsym $mod+v workspace V
bindsym $mod+w workspace W
bindsym $mod+x workspace X
bindsym $mod+y workspace Y
bindsym $mod+z workspace Z

# alt-shift-<key> = move-node-to-workspace
bindsym $mod+shift+1 move container to workspace number 1
bindsym $mod+shift+2 move container to workspace number 2
bindsym $mod+shift+3 move container to workspace number 3
bindsym $mod+shift+4 move container to workspace number 4
bindsym $mod+shift+5 move container to workspace number 5
bindsym $mod+shift+6 move container to workspace number 6
bindsym $mod+shift+7 move container to workspace number 7
bindsym $mod+shift+8 move container to workspace number 8
bindsym $mod+shift+9 move container to workspace number 9
bindsym $mod+shift+a move container to workspace A
bindsym $mod+shift+b move container to workspace B
# alt-shift-c は aerospace 同様未割り当て
bindsym $mod+shift+d move container to workspace D
bindsym $mod+shift+e move container to workspace E
bindsym $mod+shift+f move container to workspace F
bindsym $mod+shift+g move container to workspace G
bindsym $mod+shift+i move container to workspace I
bindsym $mod+shift+m move container to workspace M
bindsym $mod+shift+n move container to workspace N
bindsym $mod+shift+p move container to workspace P
bindsym $mod+shift+r move container to workspace R
bindsym $mod+shift+s move container to workspace S
bindsym $mod+shift+t move container to workspace T
bindsym $mod+shift+u move container to workspace U
bindsym $mod+shift+w move container to workspace W
bindsym $mod+shift+x move container to workspace X
bindsym $mod+shift+y move container to workspace Y
bindsym $mod+shift+z move container to workspace Z

# alt-tab = workspace-back-and-forth
bindsym $mod+Tab workspace back_and_forth
# alt-shift-tab = move-workspace-to-monitor next
bindsym $mod+shift+Tab move workspace to output right

# alt-shift-enter = fullscreen
bindsym $mod+shift+Return fullscreen toggle

# cmd-ctrl-h/j/k/l = focus-monitor
bindsym $super+ctrl+$left focus output left
bindsym $super+ctrl+$down focus output down
bindsym $super+ctrl+$up focus output up
bindsym $super+ctrl+$right focus output right

# cmd-ctrl-shift-* = move-node-to-monitor
bindsym $super+ctrl+shift+$left move container to output left
bindsym $super+ctrl+shift+$down move container to output down
bindsym $super+ctrl+shift+$up move container to output up
bindsym $super+ctrl+shift+$right move container to output right

# alt-shift-semicolon = 'mode service'
bindsym $mod+shift+semicolon mode "service"

mode "service" {
    # esc = reload-config して main へ戻る
    bindsym Escape reload; mode "default"
    # f = floating/tiling トグル
    bindsym f floating toggle; mode "default"
    # r = flatten-workspace-tree 相当 (sway に完全な等価は無いので分割をリセット)
    bindsym r layout default; mode "default"
    # backspace = close-all-windows-but-current は sway に等価が無いため未割り当て

    # sway 終了 (aerospace には無いが Linux セッション管理用に必要。
    # main モードに置くと alt+shift+e の workspace E 移動と衝突する)
    bindsym q exec swaynag -t warning -m 'Sway を終了しますか?' -B 'Yes, exit sway' 'swaymsg exit'; mode "default"
}

### ワークスペース自動割り当て ([[on-window-detected]] に対応) ###
# Linux 版アプリの app_id / class に合わせている。
# 実際の値は `swaymsg -t get_tree | grep -E 'app_id|class'` で確認できる。
assign [app_id="org.wezfurlong.wezterm"] workspace number 2
assign [class="discord"] workspace D
assign [app_id="com.mitchellh.ghostty"] workspace G
assign [app_id="Slack"] workspace S
assign [class="Slack"] workspace S
assign [app_id="notion-app"] workspace N
assign [class="zoom"] workspace Z
# ブラウザ (macOS では Arc → workspace 1)。使うブラウザに合わせて変更する。
assign [app_id="firefox"] workspace number 1
assign [app_id="google-chrome"] workspace number 1

# Ubuntu のパッケージが置くセッション連携設定 (dbus 環境変数など) を読み込む
include /etc/sway/config.d/*
